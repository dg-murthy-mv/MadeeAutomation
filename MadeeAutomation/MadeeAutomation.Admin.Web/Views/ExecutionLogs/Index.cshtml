@using MadeeAutomation.Application.Common
@model PagedResult<ExecutionLog>
@{
    ViewData["Title"] = "Execution Logs";
    string? search = ViewBag.Search;
    string? status = ViewBag.Status;
    Guid clientConfigId = ViewBag.ClientConfigId;
}

<div class="mv-page-header">
    <div>
        <h2>Execution Logs</h2>
        <div class="mv-subtle">Recent automation runs - proves ROI to a client and lets you debug fast instead of being a "launch and leave" agency.</div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Clients" asp-action="Details" asp-route-id="@clientConfigId">&larr; Back to Client</a>
</div>

<div class="mv-card">
    <div class="mv-toolbar">
        <form method="get" asp-action="Index">
            <input type="hidden" name="clientConfigId" value="@clientConfigId" />
            <input type="text" name="search" class="form-control" placeholder="Search summary or error..." value="@search" />
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                <option value="Succeeded" selected="@(status == "Succeeded")">Succeeded</option>
                <option value="Failed" selected="@(status == "Failed")">Failed</option>
                <option value="Running" selected="@(status == "Running")">Running</option>
                <option value="Pending" selected="@(status == "Pending")">Pending</option>
            </select>
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status))
            {
                <a asp-action="Index" asp-route-clientConfigId="@clientConfigId" class="btn btn-link">Clear</a>
            }
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-sm mv-table">
                <thead>
                    <tr>
                        <th>Started (UTC)</th>
                        <th>Status</th>
                        <th>Summary</th>
                        <th>Error</th>
                        <th>Duration (ms)</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var log in Model.Items)
                {
                    var rowClass = log.Status == ExecutionStatus.Failed ? "table-danger"
                        : log.Status == ExecutionStatus.Succeeded ? "table-success" : "";
                    <tr class="@rowClass">
                        <td data-label="Started">@log.StartedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td data-label="Status">@log.Status</td>
                        <td data-label="Summary">@log.ResultSummary</td>
                        <td data-label="Error" class="text-danger">@log.ErrorMessage</td>
                        <td data-label="Duration">@log.DurationMs</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mv-pagination">
            <span class="mv-subtle">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-clientConfigId="@clientConfigId" asp-route-page="@(Model.Page - 1)" asp-route-search="@search" asp-route-status="@status">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-clientConfigId="@clientConfigId" asp-route-page="@p" asp-route-search="@search" asp-route-status="@status">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-clientConfigId="@clientConfigId" asp-route-page="@(Model.Page + 1)" asp-route-search="@search" asp-route-status="@status">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="mv-empty">
            <p>No executions match your filters.</p>
        </div>
    }
</div>
