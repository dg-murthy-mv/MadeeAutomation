@inject MadeeAutomation.Admin.Web.Services.PortalNav PortalNav
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MadeeAutomation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    @* Bootstrap 5.3.3 is served from wwwroot/lib (no CDN needed - works offline and behind strict networks) *@
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mv-navbar sticky-top">
        <div class="container-fluid px-3 px-md-4" style="max-width:1200px; margin:0 auto;">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <svg width="26" height="26" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="mvLogoGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#22d3ee"/>
                            <stop offset="1" stop-color="#8b5cf6"/>
                        </linearGradient>
                    </defs>
                    <line x1="7" y1="8" x2="20" y2="8" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <line x1="7" y1="8" x2="14" y2="21" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <line x1="20" y1="8" x2="14" y2="21" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <circle cx="7" cy="8" r="4" fill="url(#mvLogoGrad)"/>
                    <circle cx="20" cy="8" r="4" fill="url(#mvLogoGrad)" opacity="0.9"/>
                    <circle cx="14" cy="21" r="4" fill="url(#mvLogoGrad)" opacity="0.75"/>
                </svg>
                <span class="d-flex flex-column lh-1">
                    <span class="mv-brand-text">MadeeAutomation</span>
                    <span class="mv-brand-tagline d-none d-sm-inline">AI automation, built for real businesses</span>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mvNav" aria-controls="mvNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="collapse navbar-collapse" id="mvNav">
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (ClientAccess.IsClientUser(User))
                        {
                            @* A client's own user: only their own business. *@
                            <a class="nav-link" asp-controller="Portal" asp-action="Index" data-testid="nav-portal-home">Home</a>
                            @if (await PortalNav.IsBeautyAsync(User))
                            {
                                <a class="nav-link" asp-controller="Bookings" asp-action="Index" data-testid="nav-bookings">Bookings</a>
                                <a class="nav-link" asp-controller="Services" asp-action="Index" data-testid="nav-services">Services</a>
                                <a class="nav-link" asp-controller="Staff" asp-action="Index" data-testid="nav-staff">Staff</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-controller="Orders" asp-action="Index" data-testid="nav-orders">Orders</a>
                                <a class="nav-link" asp-controller="Menu" asp-action="Index" data-testid="nav-menu">Menu</a>
                            }
                            <a class="nav-link" asp-controller="Hours" asp-action="Index" data-testid="nav-hours">Opening hours</a>
                            <a class="nav-link" asp-controller="Portal" asp-action="BusinessInfo" data-testid="nav-business-info">Business info</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Clients" asp-action="Index">Clients</a>
                            <a class="nav-link" asp-controller="AdminUsers" asp-action="Index" data-testid="nav-admins">Admin users</a>
                        }
                        <a class="nav-link mv-nav-user" asp-controller="Account" asp-action="MyAccount" data-testid="nav-user">@User.Identity.Name</a>
                        <a class="nav-link" asp-controller="Account" asp-action="ChangePassword" data-testid="nav-change-password">Change password</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light" data-testid="nav-logout">Sign out</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </nav>

    <div class="mv-page">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="alert" data-testid="alert-success">@successMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert" data-testid="alert-error">@errorMessage</div>
        }
        @RenderBody()
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
