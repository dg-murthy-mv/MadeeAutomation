<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MadeeAutomation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark mv-navbar sticky-top">
        <div class="container-fluid px-3 px-md-4" style="max-width:1200px; margin:0 auto;">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Clients" asp-action="Index">
                <svg width="26" height="26" viewBox="0 0 28 28" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <defs>
                        <linearGradient id="mvLogoGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#22d3ee"/>
                            <stop offset="1" stop-color="#8b5cf6"/>
                        </linearGradient>
                    </defs>
                    <line x1="7" y1="8" x2="20" y2="8" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <line x1="7" y1="8" x2="14" y2="21" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <line x1="20" y1="8" x2="14" y2="21" stroke="url(#mvLogoGrad)" stroke-width="1.5" opacity="0.55"/>
                    <circle cx="7" cy="8" r="4" fill="url(#mvLogoGrad)"/>
                    <circle cx="20" cy="8" r="4" fill="url(#mvLogoGrad)" opacity="0.9"/>
                    <circle cx="14" cy="21" r="4" fill="url(#mvLogoGrad)" opacity="0.75"/>
                </svg>
                <span class="d-flex flex-column lh-1">
                    <span class="mv-brand-text">MadeeAutomation</span>
                    <span class="mv-brand-tagline d-none d-sm-inline">AI automation, built for real businesses</span>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mvNav" aria-controls="mvNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mvNav">
                <div class="navbar-nav ms-auto">
                    <a class="nav-link" asp-controller="Clients" asp-action="Index">Clients</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="mv-page">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
