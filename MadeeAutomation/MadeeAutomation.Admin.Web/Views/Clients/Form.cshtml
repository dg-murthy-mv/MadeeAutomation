@model ClientFormModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Edit {Model.ClientName}" : "New Client";
    var action = Model.IsEdit ? "Edit" : "Create";

    void SecretField(string field, string label, string help)
    {
        var hint = Model.SavedSecretHints.GetValueOrDefault(field);
        <div class="mb-3">
            <label class="form-label" for="@field">@label</label>
            @* type="text" + CSS dots, NOT type="password": Chrome's password manager only fills/saves password
               fields, and it was putting saved values into these boxes. *@
            <div class="input-group">
                <input type="text" class="form-control mv-secret" id="@field" name="@field"
                       autocomplete="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-form-type="other"
                       placeholder="@(hint is null ? "Not set" : "Saved " + hint + " - leave blank to keep")" />
                <button type="button" class="btn btn-outline-secondary mv-secret-toggle" data-target="@field" tabindex="-1">Show</button>
            </div>
            <div class="form-text">
                @if (hint is not null)
                {
                    <span class="badge bg-success-subtle text-success-emphasis me-2" data-testid="saved-@field">Saved @hint</span>
                    <label class="form-check-label me-2">
                        <input type="checkbox" class="form-check-input" name="ClearSecrets" value="@field" data-testid="clear-@field" /> Remove
                    </label>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis me-2" data-testid="missing-@field">Not set</span>
                }
                @help
            </div>
        </div>
    }
}

<div class="mv-page-header">
    <div>
        <h2>@(Model.IsEdit ? Model.ClientName : "New Client")</h2>
        @if (Model.IsEdit)
        {
            <div class="mv-subtle">Code <code>@Model.ClientCode</code> &middot; the code is part of the webhook URLs and can't be changed.</div>
        }
    </div>
    @if (Model.IsEdit)
    {
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">&larr; Back to client</a>
    }
</div>

<form asp-action="@action" asp-route-id="@Model.Id" method="post" autocomplete="off" data-testid="client-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" data-testid="form-errors"></div>

    <div class="mv-card mv-card-body mb-4">
        <h5 class="mv-section-title">Basics</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ClientName" class="form-label"></label>
                <input asp-for="ClientName" class="form-control" placeholder="e.g. MadeeBakers" />
                <span asp-validation-for="ClientName" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ClientCode" class="form-label"></label>
                @if (Model.IsEdit)
                {
                    <input asp-for="ClientCode" class="form-control" readonly />
                }
                else
                {
                    <input asp-for="ClientCode" class="form-control" placeholder="e.g. madeebakers" />
                }
                <span asp-validation-for="ClientCode" class="text-danger small" data-testid="error-ClientCode"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label asp-for="Country" class="form-label"></label>
                <select asp-for="Country" class="form-select" id="Country" data-testid="country">
                    @foreach (var m in Markets.All)
                    {
                        <option value="@m.CountryCode" data-currency="@m.Currency" data-tz="@m.TimeZoneId">@m.CountryName</option>
                    }
                </select>
                <div class="form-text" id="marketNote">@(Markets.Find(Model.Country)?.Note)</div>
                <span asp-validation-for="Country" class="text-danger small"></span>
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="TimeZoneId" class="form-label"></label>
                <select asp-for="TimeZoneId" class="form-select" id="TimeZoneId">
                    @foreach (var tz in Markets.TimeZoneIds)
                    {
                        <option value="@tz">@tz</option>
                    }
                </select>
                <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Currency" class="form-label"></label>
                <select asp-for="Currency" class="form-select" id="Currency">
                    @foreach (var c in Markets.Currencies)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
                <div class="form-text">One currency per client.</div>
                <span asp-validation-for="Currency" class="text-danger small"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Vertical" class="form-label"></label>
                <select asp-for="Vertical" class="form-select" asp-items="Html.GetEnumSelectList<VerticalPack>()"></select>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ClientStatus>()"></select>
            </div>
        </div>

        <div class="form-check mb-2">
            <input asp-for="MerkaiIntegrationEnabled" class="form-check-input" />
            <label asp-for="MerkaiIntegrationEnabled" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="PosFirstIntegrationEnabled" class="form-check-input" />
            <label asp-for="PosFirstIntegrationEnabled" class="form-check-label"></label>
        </div>
        <div class="form-text mt-2">Paused and Cancelled clients never run workflows - their messages are logged as Skipped.</div>
    </div>

    <div class="mv-card mv-card-body mb-4">
        <h5 class="mv-section-title">What the AI may use</h5>
        <div class="mb-3">
            <label asp-for="KnowledgeBaseText" class="form-label"></label>
            <textarea asp-for="KnowledgeBaseText" class="form-control" rows="6" dir="auto"
                      placeholder="Opening hours: 7am-6pm every day&#10;Delivery: Ban Chang only, free over 300 THB&#10;Payment: PromptPay or cash"></textarea>
            <div class="form-text">The bot answers questions ONLY from this text. Anything not covered goes to staff.</div>
        </div>
        <div class="mb-0">
            <label asp-for="MenuText" class="form-label"></label>
            <textarea asp-for="MenuText" class="form-control" rows="6" dir="auto"
                      placeholder="Croissant - 45&#10;Sourdough loaf - 180&#10;Chocolate cake (1 lb) - 450"></textarea>
            <div class="form-text">One item per line, as <code>Name - price</code> (price in the client's currency). Order totals are worked out from these prices - the AI never makes up a price.</div>
        </div>
    </div>

    <div class="mv-card mv-card-body mb-4" data-testid="alerts-section">
        <h5 class="mv-section-title">When something needs a person</h5>
        <div class="mb-3">
            <label asp-for="FallbackReplyText" class="form-label"></label>
            <textarea asp-for="FallbackReplyText" class="form-control" rows="2" dir="auto"
                      placeholder="@ClientConfig.DefaultFallbackEnglish"></textarea>
            <div class="form-text">Sent to the customer if the automatic reply fails (AI down, POSFirst error). Leave blank for the default shown.</div>
            <span asp-validation-for="FallbackReplyText" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StaffAlertLineUserId" class="form-label"></label>
                <input asp-for="StaffAlertLineUserId" class="form-control font-monospace" autocomplete="off" placeholder="U520e36a2..." />
                <div class="form-text">Alerts are pushed to this LINE user through this client's LINE account. Send the account a message from your phone, then copy your id from <strong>Inbound events</strong>.</div>
                <span asp-validation-for="StaffAlertLineUserId" class="text-danger small" data-testid="error-StaffAlertLineUserId"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="StaffAlertEmail" class="form-label"></label>
                <input asp-for="StaffAlertEmail" class="form-control" autocomplete="off" placeholder="owner@example.com" />
                <div class="form-text">Needs the Email settings in WebApi (see SETUP.md).</div>
                <span asp-validation-for="StaffAlertEmail" class="text-danger small"></span>
            </div>
        </div>
    </div>

    @if (Model.IsEdit)
    {
        <div class="mv-card mv-card-body mb-4" data-testid="credentials">
            <h5 class="mv-section-title">Credentials</h5>
            <p class="mv-subtle">Stored encrypted. Saved secrets are never shown again - type a new value to replace one, leave blank to keep it.
                A channel without credentials runs in <strong>mock</strong> mode (replies are only written to the log).</p>

            <h6 class="mt-3">LINE Official Account</h6>
            <div class="form-text mb-2">LINE Official Account Manager &rarr; Settings &rarr; Messaging API (channel secret) and LINE Developers Console &rarr; Messaging API tab (channel access token).</div>
            @{ SecretField(nameof(Model.LineChannelSecret), "Channel secret", "Needed to check that webhook calls really come from LINE."); }
            @{ SecretField(nameof(Model.LineChannelAccessToken), "Channel access token (long-lived)", "Needed to send replies."); }

            <h6 class="mt-4">WhatsApp Business</h6>
            <div class="mb-3">
                <label asp-for="WhatsAppPhoneNumberId" class="form-label"></label>
                <input asp-for="WhatsAppPhoneNumberId" class="form-control" />
            </div>
            @{ SecretField(nameof(Model.WhatsAppAccessToken), "WhatsApp access token", ""); }

            <h6 class="mt-4">Facebook Messenger</h6>
            @{ SecretField(nameof(Model.MessengerPageAccessToken), "Page access token", ""); }

            <h6 class="mt-4">POSFirst</h6>
            <div class="mb-3">
                <label asp-for="PosFirstBaseUrl" class="form-label"></label>
                <input asp-for="PosFirstBaseUrl" class="form-control" placeholder="https://pos.client.com" />
                <span asp-validation-for="PosFirstBaseUrl" class="text-danger small"></span>
            </div>
            @{ SecretField(nameof(Model.PosFirstApiKey), "POSFirst API key", ""); }

            <h6 class="mt-4">Merkai CRM</h6>
            <div class="mb-3">
                <label asp-for="MerkaiBaseUrl" class="form-label"></label>
                <input asp-for="MerkaiBaseUrl" class="form-control" placeholder="https://crm.client.com" />
                <span asp-validation-for="MerkaiBaseUrl" class="text-danger small"></span>
            </div>
            @{ SecretField(nameof(Model.MerkaiApiKey), "Merkai API key", ""); }
        </div>
    }

    <button type="submit" class="btn btn-primary" data-testid="save-client">@(Model.IsEdit ? "Save client" : "Create client")</button>
    <a asp-action="@(Model.IsEdit ? "Details" : "Index")" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
<script>
    // Secrets are type="text" + CSS dots so Chrome's password manager ignores them.
    // Browsers without the dots feature get a password box instead, so a secret is never shown in plain text.
    const dotsSupported = window.CSS && (CSS.supports('-webkit-text-security', 'disc') || CSS.supports('text-security', 'disc'));
    document.querySelectorAll('.mv-secret').forEach(input => {
        if (!dotsSupported) { input.type = 'password'; input.autocomplete = 'new-password'; }
    });
    document.querySelectorAll('.mv-secret-toggle').forEach(btn => btn.addEventListener('click', () => {
        const input = document.getElementById(btn.dataset.target);
        const shown = !input.classList.contains('mv-secret-shown');
        input.classList.toggle('mv-secret-shown', shown);
        if (!dotsSupported) input.type = shown ? 'text' : 'password';
        btn.textContent = shown ? 'Hide' : 'Show';
    }));

    // Choosing a country fills in its currency and time zone.
    const country = document.getElementById('Country');
    country.addEventListener('change', () => {
        const opt = country.options[country.selectedIndex];
        document.getElementById('Currency').value = opt.dataset.currency;
        document.getElementById('TimeZoneId').value = opt.dataset.tz;
    });
</script>
}
