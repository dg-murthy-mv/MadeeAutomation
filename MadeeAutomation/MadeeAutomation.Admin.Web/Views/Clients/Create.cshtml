@model ClientConfig
@{
    ViewData["Title"] = "New Client";
}

<div class="mv-page-header">
    <div><h2>New Client</h2></div>
</div>

<div class="mv-card mv-card-body" style="max-width: 640px;">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Client Name</label>
        <input asp-for="ClientName" class="form-control" placeholder="e.g. MadeeBakers" />
    </div>

    <div class="mb-3">
        <label class="form-label">Client Code (short slug)</label>
        <input asp-for="ClientCode" class="form-control" placeholder="e.g. madeebakers" />
    </div>

    <div class="row">
        <div class="col mb-3">
            <label class="form-label">Country</label>
            <select asp-for="Country" class="form-select">
                <option value="TH">Thailand</option>
                <option value="IN">India</option>
                <option value="PH">Philippines</option>
                <option value="AE">UAE</option>
            </select>
        </div>
        <div class="col mb-3">
            <label class="form-label">Vertical</label>
            <select asp-for="Vertical" class="form-select" asp-items="Html.GetEnumSelectList<VerticalPack>()"></select>
        </div>
    </div>

    <div class="row">
        <div class="col mb-3">
            <label class="form-label">Timezone</label>
            <input asp-for="TimeZoneId" class="form-control" value="Asia/Bangkok" />
        </div>
        <div class="col mb-3">
            <label class="form-label">Currency</label>
            <input asp-for="Currency" class="form-control" value="THB" />
        </div>
    </div>

    <div class="form-check mb-2">
        <input asp-for="MerkaiIntegrationEnabled" class="form-check-input" />
        <label class="form-check-label">Merkai CRM integration enabled</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="PosFirstIntegrationEnabled" class="form-check-input" />
        <label class="form-check-label">POSFirst integration enabled</label>
    </div>

    <button type="submit" class="btn btn-primary">Create Client</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
</div>
