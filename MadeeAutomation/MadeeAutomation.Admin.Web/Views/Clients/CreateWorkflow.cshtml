@model WorkflowDefinition
@{
    ViewData["Title"] = "New Workflow";
}

<div class="mv-page-header">
    <div><h2>New Workflow</h2></div>
</div>

<div class="mv-card mv-card-body" style="max-width: 640px;">
<form asp-action="CreateWorkflow" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClientConfigId" />

    <div class="mb-3">
        <label class="form-label">Workflow Name</label>
        <input asp-for="Name" class="form-control" placeholder="e.g. WhatsApp Order Intake" />
    </div>

    <div class="mb-3">
        <label class="form-label">Vertical Pack</label>
        <select asp-for="Vertical" class="form-select" asp-items="Html.GetEnumSelectList<VerticalPack>()"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Handler Key</label>
        <select asp-for="HandlerKey" class="form-select">
            <option value="whatsapp-order-parser">whatsapp-order-parser (F&amp;B/Retail)</option>
            <option value="line-order-parser">line-order-parser (F&amp;B/Retail)</option>
            <option value="low-stock-alert">low-stock-alert (F&amp;B/Retail)</option>
            <option value="lead-scoring">lead-scoring (CRM/Sales)</option>
            <option value="invoice-extraction">invoice-extraction (Finance/Chit)</option>
            <option value="faq-responder">faq-responder (Customer Support)</option>
        </select>
        <div class="form-text">Must match an IHandler.HandlerKey registered in MadeeAutomation.Application.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Trigger Type</label>
        <select asp-for="TriggerType" class="form-select" asp-items="Html.GetEnumSelectList<TriggerType>()"></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Trigger Config (JSON)</label>
        <textarea asp-for="TriggerConfigJson" class="form-control" rows="3" placeholder='{ "cron": "0 7 * * *" }'></textarea>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsEnabled" class="form-check-input" checked />
        <label class="form-check-label">Enabled</label>
    </div>

    <button type="submit" class="btn btn-primary">Create Workflow</button>
    <a asp-action="Details" asp-route-id="@Model.ClientConfigId" class="btn btn-link">Cancel</a>
</form>
</div>
