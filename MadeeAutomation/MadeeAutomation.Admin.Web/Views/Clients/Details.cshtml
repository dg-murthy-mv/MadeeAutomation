@model ClientDetailsModel
@{
    var client = Model.Client;
    ViewData["Title"] = client.ClientName;
    var s = Model.Settings;

    void Status(bool ok, string okText, string missingText, string testId)
    {
        if (ok)
        {
            <span class="badge bg-success" data-testid="@testId">@okText</span>
        }
        else
        {
            <span class="badge bg-warning text-dark" data-testid="@testId">@missingText</span>
        }
    }

    void UrlRow(string label, string url, string testId)
    {
        <div class="mv-url-row">
            <span class="mv-url-label">@label</span>
            <code class="mv-url" data-testid="@testId">@url</code>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="navigator.clipboard.writeText('@url'); this.textContent='Copied';">Copy</button>
        </div>
    }
}

<div class="mv-page-header">
    <div>
        <h2>@client.ClientName</h2>
        <div class="mv-subtle"><code>@client.ClientCode</code> &middot; @client.Country &middot; @client.Vertical &middot; <partial name="_StatusBadge" model="client.Status" /></div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@client.Id" data-testid="edit-client">Edit client &amp; credentials</a>
        <a class="btn btn-outline-secondary" asp-controller="ExecutionLogs" asp-action="Index" asp-route-clientConfigId="@client.Id" data-testid="view-logs">View Execution Logs</a>
        <a class="btn btn-outline-secondary" asp-controller="InboundEvents" asp-action="Index" asp-route-clientConfigId="@client.Id" data-testid="view-inbound">Inbound events</a>
        <a class="btn btn-primary" asp-action="CreateWorkflow" asp-route-clientConfigId="@client.Id" data-testid="new-workflow">+ New Workflow</a>
    </div>
</div>

@if (Model.SettingsError is not null)
{
    <div class="alert alert-danger" data-testid="settings-error">@Model.SettingsError</div>
}

<div class="mv-card mv-card-body mb-4" data-testid="channels-card">
    <h5 class="mv-section-title">Channels &amp; webhook URLs</h5>

    <div class="mv-channel">
        <div class="mv-channel-head">
            <strong>LINE</strong>
            @{ Status(s?.HasLineSecret == true, "Channel secret saved", "Channel secret missing - LINE calls are refused", "line-secret-status"); }
            @{ Status(s?.HasLineToken == true, "Access token saved", "No access token - replies are mock only", "line-token-status"); }
        </div>
        @{ UrlRow("Webhook URL", Model.LineWebhookUrl, "line-webhook-url"); }
        @if (s?.HasLineToken == true)
        {
            <form asp-action="CheckLine" asp-route-id="@client.Id" method="post" class="mt-2">
                <button type="submit" class="btn btn-sm btn-outline-primary" data-testid="check-line">Check LINE access token</button>
                <span class="small mv-subtle ms-1">Asks LINE which account the saved token belongs to. Nothing is sent.</span>
            </form>
        }
        <div class="form-text">Paste into LINE Developers Console &rarr; Messaging API &rarr; Webhook URL, turn "Use webhook" on, and turn Chat OFF in LINE Official Account Manager &rarr; Response settings.</div>
    </div>

    <div class="mv-channel">
        <div class="mv-channel-head">
            <strong>WhatsApp</strong>
            @{ Status(s?.HasWhatsApp == true, "Credentials saved", "Not set - mock", "whatsapp-status"); }
        </div>
        @{ UrlRow("Callback URL", Model.WhatsAppWebhookUrl, "whatsapp-webhook-url"); }
    </div>

    <div class="mv-channel">
        <div class="mv-channel-head">
            <strong>Messenger</strong>
            @{ Status(s?.HasMessenger == true, "Credentials saved", "Not set - mock", "messenger-status"); }
        </div>
        @{ UrlRow("Callback URL", Model.MessengerWebhookUrl, "messenger-webhook-url"); }
    </div>

    <div class="mv-channel mb-0">
        <div class="mv-channel-head">
            <strong>POSFirst</strong>
            @{ Status(s?.HasPosFirst == true, "Connected", "No POS - orders stay on the Orders page (ORD-...)", "posfirst-status"); }
        </div>
    </div>
</div>

<div class="mv-card mv-card-body mb-4" data-testid="business-card">
    <h5 class="mv-section-title">Menu &amp; opening hours</h5>
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div><strong>Menu:</strong> <span data-testid="menu-count">@Model.MenuItemCount item(s)</span>
                @if (Model.SoldOutCount > 0) { <span class="badge bg-warning text-dark ms-1">@Model.SoldOutCount sold out</span> }
            </div>
            @if (Model.MenuItemCount == 0 && !string.IsNullOrWhiteSpace(client.MenuText))
            {
                <div class="small mv-subtle">Using the old menu text for now. Open Menu to import it.</div>
            }
            <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="Menu" asp-action="Index" asp-route-clientConfigId="@client.Id" data-testid="open-menu">Menu</a>
        </div>
        <div class="col-12 col-md-6">
            <div><strong>Right now:</strong> <span data-testid="hours-status">@(Model.HoursStatus?.StatusText ?? "Opening hours are not set.")</span></div>
            <div class="small mv-subtle">@client.TimeZoneId</div>
            <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="Hours" asp-action="Index" asp-route-clientConfigId="@client.Id" data-testid="open-hours">Opening hours</a>
        </div>
    </div>
</div>

<div class="mv-card mv-card-body mb-4" data-testid="orders-card">
    <h5 class="mv-section-title">Orders</h5>
    <div>
        <strong data-testid="new-order-count">@Model.NewOrderCount</strong> new order(s) waiting for staff.
        Every order the bot takes is saved here@(s?.HasPosFirst == true ? " and sent to POSFirst" : "").
    </div>
    @if (Model.OrdersOnlyOnPage)
    {
        <div class="alert alert-warning mt-2 mb-0" data-testid="orders-only-warning">
            This client has <strong>no POS</strong> and <strong>no staff LINE user id or staff email</strong>.
            Nobody is told when an order comes in - it only appears on the Orders page. Set one under <em>Edit client &amp; credentials</em>.
        </div>
    }
    <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="Orders" asp-action="Index" asp-route-clientConfigId="@client.Id" data-testid="open-orders">Orders</a>
</div>

<div class="mv-card mv-card-body mb-4" data-testid="portal-users-card">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div>
            <h5 class="mv-section-title mb-1">Client portal users</h5>
            <div class="small mv-subtle">
                People at @client.ClientName who can sign in and change their own menu, sold-out items, opening hours, closed dates and business information, and see their orders.
                They sign in at <code>@($"{Context.Request.Scheme}://{Context.Request.Host}")</code> and can never see another client.
            </div>
        </div>
        <a class="btn btn-sm btn-primary" asp-controller="ClientUsers" asp-action="Create" asp-route-clientConfigId="@client.Id" data-testid="new-portal-user">+ Add portal user</a>
    </div>
    @if (Model.PortalUsers.Count == 0)
    {
        <div class="mv-subtle mt-2" data-testid="no-portal-users">No portal users yet - we make the changes for this client.</div>
    }
    else
    {
        <ul class="list-group mt-3" data-testid="portal-users">
            @foreach (var u in Model.PortalUsers)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2" data-testid="portal-user-row" data-email="@u.Email">
                    <span>
                        @u.DisplayName <span class="mv-subtle">&middot; @u.Email</span>
                        @if (!u.IsActive) { <span class="badge bg-secondary ms-1" data-testid="portal-user-status">Deactivated</span> }
                        else if (u.MustChangePassword) { <span class="badge bg-warning text-dark ms-1" data-testid="portal-user-status">Must change password</span> }
                        else { <span class="badge bg-success ms-1" data-testid="portal-user-status">Active</span> }
                    </span>
                    <span class="d-flex flex-wrap gap-1">
                        <form asp-controller="ClientUsers" asp-action="ResetPassword" asp-route-id="@u.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="reset-portal-user">New temporary password</button>
                        </form>
                        <form asp-controller="ClientUsers" asp-action="ToggleActive" asp-route-id="@u.Id" method="post">
                            <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")" data-testid="toggle-portal-user">@(u.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </span>
                </li>
            }
        </ul>
    }
</div>

<div class="mv-card">
    <div class="mv-card-body pb-0"><h5 class="mv-section-title">Workflows</h5></div>
    @if (client.Workflows.Any())
    {
        <div class="table-responsive">
            <table class="table mv-table align-middle" data-testid="workflows-table">
                <thead>
                    <tr>
                        <th>Workflow</th>
                        <th>Handler</th>
                        <th>Trigger</th>
                        <th>Channel</th>
                        <th>Enabled</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var workflow in client.Workflows.OrderBy(w => w.CreatedAtUtc))
                {
                    <tr data-testid="workflow-row" data-workflow-id="@workflow.Id">
                        <td data-label="Workflow">
                            <span data-testid="workflow-name">@workflow.Name</span>
                            @if (workflow.TriggerType == TriggerType.Webhook)
                            {
                                <div class="small mv-subtle text-break">@Model.GenericWebhookUrl(workflow.Id)</div>
                            }
                        </td>
                        <td data-label="Handler"><code>@workflow.HandlerKey</code></td>
                        <td data-label="Trigger">@workflow.TriggerType</td>
                        <td data-label="Channel">@(workflow.TriggerType == TriggerType.MessageReceived ? Channels.DisplayName(workflow.Channel) : "-")</td>
                        <td data-label="Enabled">
                            <span class="badge @(workflow.IsEnabled ? "bg-success" : "bg-secondary")" data-testid="workflow-enabled">@(workflow.IsEnabled ? "Yes" : "No")</span>
                        </td>
                        <td data-label="" class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="EditWorkflow" asp-route-id="@workflow.Id" data-testid="edit-workflow">Edit</a>
                            @if (workflow.TriggerType == TriggerType.MessageReceived)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="TestWorkflow" asp-route-id="@workflow.Id" data-testid="test-workflow">Test</a>
                            }
                            <form asp-action="ToggleWorkflow" asp-route-id="@workflow.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm @(workflow.IsEnabled ? "btn-outline-warning" : "btn-outline-success")" data-testid="toggle-workflow">
                                    @(workflow.IsEnabled ? "Disable" : "Enable")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="mv-empty">
            <p>No workflows yet. Add a <strong>Customer messages</strong> workflow for LINE to start answering customers.</p>
        </div>
    }
</div>
