@model PagedResult<ClientConfig>
@{
    ViewData["Title"] = "Clients";
    string? search = ViewBag.Search;
    int pageSize = ViewBag.PageSize;
}

<div class="mv-page-header">
    <div>
        <h2>Clients</h2>
        <div class="mv-subtle">@Model.TotalCount client@(Model.TotalCount == 1 ? "" : "s")</div>
    </div>
    <a class="btn btn-primary" asp-action="Create" data-testid="new-client">+ New Client</a>
</div>

<div class="mv-card">
    <div class="mv-toolbar">
        <form method="get" asp-action="Index">
            <input type="text" name="search" class="form-control" placeholder="Search by name or code..." value="@search" />
            <select name="pageSize" class="form-select" style="max-width:140px;" onchange="this.form.submit()">
                @foreach (var size in new[] { 5, 10, 25, 50 })
                {
                    <option value="@size" selected="@(pageSize == size)">@size / page</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a asp-action="Index" class="btn btn-link">Clear</a>
            }
        </form>
    </div>

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table mv-table align-middle" data-testid="clients-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Code</th>
                        <th>Country</th>
                        <th>Vertical</th>
                        <th>Status</th>
                        <th># Workflows</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var client in Model.Items)
                {
                    <tr data-testid="client-row-@client.ClientCode">
                        <td data-label="Client">@client.ClientName</td>
                        <td data-label="Code"><code>@client.ClientCode</code></td>
                        <td data-label="Country">@client.Country</td>
                        <td data-label="Vertical"><span class="badge badge-vertical">@client.Vertical</span></td>
                        <td data-label="Status"><partial name="_StatusBadge" model="client.Status" /></td>
                        <td data-label="Workflows">@client.Workflows.Count</td>
                        <td data-label=""><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@client.Id">Manage</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mv-pagination">
            <span class="mv-subtle">Page @Model.Page of @Model.TotalPages</span>
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@search" asp-route-pageSize="@pageSize">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search" asp-route-pageSize="@pageSize">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@search" asp-route-pageSize="@pageSize">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="mv-empty">
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <p>No clients match "<strong>@search</strong>".</p>
            }
            else
            {
                <p>No clients yet. Add your first client to start configuring automations.</p>
            }
        </div>
    }
</div>
