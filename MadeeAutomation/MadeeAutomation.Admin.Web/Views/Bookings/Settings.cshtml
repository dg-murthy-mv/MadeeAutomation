@model BookingSettingsPageModel
@{
    var client = Model.Client;
    ViewData["Title"] = $"Booking settings - {client.ClientName}";
    var plan = MadeeAutomation.Domain.Billing.PlanCatalog.For(client.Plan);
    var upgradeText = $"Not in the {plan.Name} plan";
}

<div class="mv-page-header">
    <div>
        <h2>Booking settings</h2>
        <div class="mv-subtle"><partial name="_ClientCrumb" model="client" /> &middot; how customers can book in the chat</div>
    </div>
    <partial name="_BeautyLinks" model='(client, "settings")' />
</div>

<form asp-action="Settings" method="post" autocomplete="off" class="mv-card mv-card-body" style="max-width: 760px">
    <input type="hidden" asp-for="Form.ClientConfigId" />
    <h5 class="mv-section-title">Times offered</h5>
    <div class="row g-2 mb-3">
        <div class="col-12 col-md-4">
            <label asp-for="Form.SlotMinutes" class="form-label"></label>
            <select asp-for="Form.SlotMinutes" class="form-select" data-testid="set-slot">
                @foreach (var m in new[] { 15, 20, 30, 45, 60 }) { <option value="@m">@m minutes</option> }
            </select>
            <span asp-validation-for="Form.SlotMinutes" class="text-danger small"></span>
        </div>
        <div class="col-6 col-md-4">
            <label asp-for="Form.MinNoticeMinutes" class="form-label"></label>
            <input asp-for="Form.MinNoticeMinutes" class="form-control" type="number" min="0" max="10080" inputmode="numeric" data-testid="set-notice" />
            <span asp-validation-for="Form.MinNoticeMinutes" class="text-danger small" data-testid="set-notice-error"></span>
        </div>
        <div class="col-6 col-md-4">
            <label asp-for="Form.DaysAhead" class="form-label"></label>
            <input asp-for="Form.DaysAhead" class="form-control" type="number" min="1" max="90" inputmode="numeric" data-testid="set-days" />
            <span asp-validation-for="Form.DaysAhead" class="text-danger small" data-testid="set-days-error"></span>
        </div>
    </div>

    <h5 class="mv-section-title">Home service</h5>
    <div class="form-check mb-2">
        <input asp-for="Form.HomeServiceEnabled" class="form-check-input" data-testid="set-home" />
        <label asp-for="Form.HomeServiceEnabled" class="form-check-label"></label>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-4">
            <label asp-for="Form.HomeServiceFee" class="form-label">Fee (@client.Currency)</label>
            <input asp-for="Form.HomeServiceFee" class="form-control" type="number" step="0.01" min="0" inputmode="decimal" data-testid="set-home-fee" />
            <span asp-validation-for="Form.HomeServiceFee" class="text-danger small"></span>
        </div>
        <div class="col-6 col-md-4">
            <label asp-for="Form.HomeServiceTravelMinutes" class="form-label">Travel time (min)</label>
            <input asp-for="Form.HomeServiceTravelMinutes" class="form-control" type="number" min="0" max="240" inputmode="numeric" data-testid="set-travel" />
            <span asp-validation-for="Form.HomeServiceTravelMinutes" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-text mb-3">Only services marked "home service" and staff who do home service are offered. Travel time is blocked before and after each home visit.</div>

    <h5 class="mv-section-title">Messages to customers</h5>
    <div class="form-check mb-1">
        <input asp-for="Form.NotifyCustomer" class="form-check-input" data-testid="set-notify" />
        <label asp-for="Form.NotifyCustomer" class="form-check-label"></label>
    </div>
    <div class="form-check mb-1">
        <input asp-for="Form.RemindersEnabled" class="form-check-input" data-testid="set-reminders" />
        <label asp-for="Form.RemindersEnabled" class="form-check-label"></label>
    </div>
    <div class="form-check mb-1 ms-4">
        <fieldset class="d-inline" disabled="@(!plan.SecondReminder)"><input asp-for="Form.SecondReminderEnabled" class="form-check-input" data-testid="set-reminder2" />
        <label asp-for="Form.SecondReminderEnabled" class="form-check-label"></label></fieldset>
        @if (!plan.SecondReminder) { <span class="badge text-bg-secondary ms-1" data-testid="plan-lock-reminder2">@upgradeText</span> }
    </div>
    <div class="form-text mb-3">
        The reminder goes out a day before (2 hours before for bookings made later), with "I'll be there", "Reschedule" and "Cancel" buttons.
        Clinics usually also send the 2-hour one.
    </div>
    <div class="row g-2 align-items-end mb-1">
        <div class="col-12 col-md-7">
            <div class="form-check">
                <fieldset class="d-inline" disabled="@(!plan.Feedback)"><input asp-for="Form.FeedbackEnabled" class="form-check-input" data-testid="set-feedback" />
                <label asp-for="Form.FeedbackEnabled" class="form-check-label"></label></fieldset>
                @if (!plan.Feedback) { <span class="badge text-bg-secondary ms-1" data-testid="plan-lock-feedback">@upgradeText</span> }
            </div>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="Form.FeedbackDelayHours" class="form-label small mb-1"></label>
            <input asp-for="Form.FeedbackDelayHours" class="form-control form-control-sm" type="number" min="0" max="72" data-testid="set-feedback-hours" />
            <span asp-validation-for="Form.FeedbackDelayHours" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-text mb-3">Sent when you press "Completed". Low ratings (1-2 stars) are sent to your staff alert at once; all ratings are in Reports.</div>
    <div class="form-check mb-1">
        <fieldset class="d-inline" disabled="@(!plan.Waitlist)"><input asp-for="Form.WaitlistEnabled" class="form-check-input" data-testid="set-waitlist" />
        <label asp-for="Form.WaitlistEnabled" class="form-check-label"></label></fieldset>
        @if (!plan.Waitlist) { <span class="badge text-bg-secondary ms-1" data-testid="plan-lock-waitlist">@upgradeText</span> }
    </div>
    <div class="form-text mb-3">When nothing is free, the customer can tap "Join waitlist". When a time opens up, everyone waiting for it gets a message - the first to tap gets it.</div>

    <h5 class="mv-section-title mt-4">WhatsApp templates</h5>
    <div class="form-text mb-2">
        WhatsApp only lets a business message a customer within 24 hours of the customer's last message. Reminders, follow-ups,
        feedback questions and waitlist offers usually come later, so on WhatsApp they need <strong>message templates approved by Meta</strong>
        (WhatsApp Manager &rarr; Message templates; see SETUP for the exact texts). Type the names here once they are approved.
        Empty = a normal message is tried; if WhatsApp refuses it, the booking shows it so you can text the customer.
        LINE has no such limit, and Messenger has no templates yet.
    </div>
    <div class="row g-2 mb-3" data-testid="set-templates">
        <div class="col-6 col-md-4">
            <label asp-for="Form.TemplateLanguage" class="form-label small mb-1"></label>
            <input asp-for="Form.TemplateLanguage" class="form-control form-control-sm" placeholder="en" data-testid="set-tpl-language" />
            <span asp-validation-for="Form.TemplateLanguage" class="text-danger small"></span>
        </div>
        @foreach (var (field, id, example) in new[] { ("TemplateReminder", "set-tpl-reminder", "appointment_reminder"), ("TemplateFollowUp", "set-tpl-followup", "follow_up_reminder"),
                                                       ("TemplateFeedback", "set-tpl-feedback", "visit_feedback"), ("TemplateWaitlist", "set-tpl-waitlist", "waitlist_offer") })
        {
            <div class="col-6 col-md-4">
                <label class="form-label small mb-1" for="Form_@field">@(field switch { "TemplateReminder" => "Reminder template", "TemplateFollowUp" => "Follow-up template", "TemplateFeedback" => "Feedback template", _ => "Waitlist template" })</label>
                <input class="form-control form-control-sm" id="Form_@field" name="Form.@field" value="@(field switch { "TemplateReminder" => Model.Form.TemplateReminder, "TemplateFollowUp" => Model.Form.TemplateFollowUp, "TemplateFeedback" => Model.Form.TemplateFeedback, _ => Model.Form.TemplateWaitlist })"
                       placeholder="@example" data-testid="@id" />
                <span class="text-danger small" data-valmsg-for="Form.@field" data-valmsg-replace="true">@(ViewData.ModelState[$"Form.{field}"]?.Errors.FirstOrDefault()?.ErrorMessage)</span>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary" data-testid="save-settings">Save</button>
</form>
