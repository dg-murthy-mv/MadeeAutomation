@{ ViewData["Title"] = "Reset link not valid"; }

<div class="mv-auth-card mv-card mv-card-body">
    <h2 class="mb-3">Reset link not valid</h2>
    <div class="alert alert-warning" data-testid="reset-link-problem">@ViewBag.LinkProblem</div>
    <a asp-action="ForgotPassword" class="btn btn-primary w-100">Ask for a new link</a>
    <div class="mt-3 text-center"><a asp-action="Login">Back to sign in</a></div>
</div>
