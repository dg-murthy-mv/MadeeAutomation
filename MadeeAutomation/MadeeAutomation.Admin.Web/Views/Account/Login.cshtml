@model LoginModel
@{ ViewData["Title"] = "Sign in"; }

<div class="mv-auth-card mv-card mv-card-body">
    <h2 class="mb-1">Sign in</h2>
    <p class="mv-subtle mb-4">MadeeAutomation Admin</p>

    <form asp-action="Login" method="post" data-testid="login-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" data-testid="login-error"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100" data-testid="login-submit">Sign in</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="ForgotPassword" data-testid="forgot-link">Forgot password?</a>
    </div>
</div>
