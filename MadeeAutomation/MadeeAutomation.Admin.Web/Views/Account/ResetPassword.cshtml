@model ResetPasswordModel
@{ ViewData["Title"] = "Choose a new password"; }

<div class="mv-auth-card mv-card mv-card-body">
    <h2 class="mb-1">Choose a new password</h2>
    <p class="mv-subtle mb-4">For <strong>@Model.Email</strong></p>

    <form asp-action="ResetPassword" method="post" data-testid="reset-form">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text">At least 10 characters, with a letter and a number.</div>
            <span asp-validation-for="NewPassword" class="text-danger small" data-testid="error-NewPassword"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100" data-testid="reset-submit">Save new password</button>
    </form>
</div>
