@model MyAccountModel
@{ ViewData["Title"] = "My account"; }

<div class="mv-auth-card mv-card mv-card-body">
    <h2 class="mb-1">My account</h2>
    <p class="mv-subtle mb-4">@Model.Email</p>

    <form asp-action="MyAccount" method="post" data-testid="my-account-form">
        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label"></label>
            <input asp-for="DisplayName" class="form-control" />
            <span asp-validation-for="DisplayName" class="text-danger small"></span>
        </div>
        @if (!ClientAccess.IsClientUser(User))
        {
        <div class="mb-3">
            <label asp-for="TimeZoneId" class="form-label"></label>
            <select asp-for="TimeZoneId" class="form-select">
                @foreach (var tz in Markets.TimeZoneIds)
                {
                    <option value="@tz">@tz</option>
                }
            </select>
            <div class="form-text">Used on admin-only pages such as Admin users. Client pages (logs, inbound events) always use the client's own time zone.</div>
            <span asp-validation-for="TimeZoneId" class="text-danger small"></span>
        </div>
        }
        else
        {
            <div class="form-text mb-3">Times are shown in your business's time zone.</div>
        }
        <button type="submit" class="btn btn-primary w-100" data-testid="save-my-account">Save</button>
    </form>

    <div class="mt-3 text-center"><a asp-action="ChangePassword">Change password</a></div>
</div>
