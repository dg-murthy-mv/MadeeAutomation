@model ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }

<div class="mv-auth-card mv-card mv-card-body">
    <h2 class="mb-1">Forgot password</h2>
    <p class="mv-subtle mb-4">Enter your admin email. We'll send a link to choose a new password (valid for 1 hour).</p>

    <form asp-action="ForgotPassword" method="post" data-testid="forgot-form">
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100" data-testid="forgot-submit">Send reset link</button>
    </form>

    <div class="mt-3 text-center"><a asp-action="Login">Back to sign in</a></div>
</div>
